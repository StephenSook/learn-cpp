{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "C++: build and run current file",
      "type": "shell",
      "command": "clang++ -std=c++20 -g -Wall -Wextra -Wconversion -Wsign-conversion -pedantic-errors \"${file}\" -o \"${fileDirname}/${fileBasenameNoExtension}\" && \"${fileDirname}/${fileBasenameNoExtension}\"",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$gcc"]
    }
  ]
}
